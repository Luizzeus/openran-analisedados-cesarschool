# Fase 3 SMO/OAM.
# Copy to your shell environment or source manually after editing.

# local: SMO-lite incluido neste repo (padrao, leve, sem containers SMO).
# external: usa checkout externo O-RAN SC OAM/SMO.
SMO_MODE=local

# External checkout of O-RAN SC OAM/SMO (necessario apenas com SMO_MODE=external).
SMO_OAM_DIR=/path/to/o-ran-sc-oam

# Isolated Docker Compose project name used by scripts/up_smo_lab.sh.
SMO_PROJECT_NAME=oai-smo-lab

# Runtime dir for local mode.
SMO_RUN_DIR=logs/smo_lab_runtime

# Optional compose layers for external mode.
SMO_WITH_NETWORK=0
SMO_WITH_TEIV=0

# External mode default: abort if Fase 1/Fase 2 containers/processes are active.
SMO_ALLOW_SHARED_HOST=0

# Local interface endpoints used by scripts/smo_lab_snapshot.sh.
NONRT_PMS_URL=http://127.0.0.1:8081/a1-policy/v2
A1_MEDIATOR_URL=http://127.0.0.1:10000/a1-p
SMO_TOPOLOGY_FILE=config/smo/topology.lab.json
SMO_EVENT_LOG=logs/smo_lab_events.jsonl
